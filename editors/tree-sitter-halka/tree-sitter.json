{
  "grammars": [
    {
      "name": "halka",
      "camelcase": "Halka",
      "scope": "source.halka",
      "path": ".",
      "file-types": [
        "hk"
      ],
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm",
      "locals": "queries/locals.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT OR Apache-2.0",
    "description": "Tree-sitter grammar for the Halka programming language",
    "links": {
      "repository": "https://github.com/halka-lang/halka.git"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true
  }
}
