# Control flow, match, destructuring, defer (#4, #8, #9, #10, #24).
classify(n),
    match n,
        0,
            give "zero",
        1,
            give "one",
        k if k > 1,
            give "many",
        else,
            give "negative"

say classify(0)
say classify(1)
say classify(9)
say classify(-1)

let [x, _, z]: [1, 2, 3]
say x
say z
let [head, ...tail]: [1, 2, 3, 4]
say head
say tail
let (p, q): (7, 8)
say p + q

first_even(items),
    for i in items,
        if i % 2 == 1,
            continue,
        give i,
    give null

say first_even([1, 3, 4, 5])
say first_even([1, 3, 5])

cleanup_order(),
    defer say "third",
    defer say "second",
    say "first"

cleanup_order()

match [1, 2, 3],
    [],
        say "empty",
    [f, ...r],
        say "head {f} rest {r}"
