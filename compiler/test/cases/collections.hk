# Data structures, indexing, slicing, ranges (#5, #6, #54).
let numbers: [10, 20, 30, 40, 50]
say numbers[0]
say numbers[-1]
say numbers[1:3]
say numbers[:2]
say numbers[3:]
say numbers[::-1]
say numbers[0:5:2]
let m: ["a": 1, "b": 2]
say m["a"]
say m["missing"]
say sorted(m.keys())
let s: {1, 2, 2, 3}
say s.length
let t: (1, "two", 3.0)
say t[1]
say len("नमस्ते")
for i in 1..4,
    say i
for i in 1..=3,
    say i
