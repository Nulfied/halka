# Structs are C structs: by value, no indirection.
Point:
    x: float,
    y: float

Counter:
    value: int,
    step: int

dist2(p: Point): float,
    give p.x * p.x + p.y * p.y

advance(c: Counter): int,
    give c.value + c.step

let p: Point(3.0, 4.0)
say dist2(p)
say p.x
let c: Counter(10, 5)
say advance(c)

# A struct field that owns heap memory. The emitter used to fall back to
# `any` for every field type, which lowers to hk_int, so this assigned an
# hk_str * to an integer and the C compiler built it anyway.
Person:
    name: string,
    age: int

greet(p: Person): string,
    give "hi {p.name}, {p.age}"

let a: Person("Asha", 30)
say greet(a)
say a.name
