# Structs are C structs: by value, no indirection.
Point:
    x: float,
    y: float

Counter:
    value: int,
    step: int

dist2(p: Point): float,
    give p.x * p.x + p.y * p.y

advance(c: Counter): int,
    give c.value + c.step

let p: Point(3.0, 4.0)
say dist2(p)
say p.x
let c: Counter(10, 5)
say advance(c)
