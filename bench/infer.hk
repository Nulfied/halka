# One dense layer over a batch, the shape an inference step actually has:
#   y = relu(x @ W + b), then argmax per row.
#
# 4096 rows x 512 features x 32 classes = 67M multiply-adds. Compared against
# the same computation written by hand in C and against NumPy, which is the
# real competition here — NumPy's inner loop is already C, so "faster than
# Python" is not the claim being tested. The claim is "as fast as C".

import time

const rows: 4096
const feats: 512
const classes: 32

dot(x: list(float), w: list(float), xoff: int, woff: int, n: int): float,
    let acc: 0.0,
    for j in 0..n,
        acc: acc + x[xoff + j] * w[woff + j],
    give acc

main(),
    # Deterministic inputs, so all three implementations compute the same
    # thing and the checksum can be compared across them.
    let w: [],
    for i in 0..feats * classes,
        w.push(0.001 * ((i % 7) as float - 3.0)),
    let b: [],
    for c in 0..classes,
        b.push(0.01 * c as float),
    let x: [],
    for i in 0..rows * feats,
        x.push(0.5 * ((i % 13) as float - 6.0)),
    let t_start: time.monotonic(),
    let total: 0,
    for r in 0..rows,
        let best: 0,
        let bestv: -1000000.0,
        for c in 0..classes,
            let v: dot(x, w, r * feats, c * feats, feats) + b[c],
            if v < 0.0,
                v: 0.0,
            if v > bestv,
                bestv: v,
                best: c,
        total: total + best,
    let elapsed: time.monotonic() - t_start,
    say "infer checksum {total}",
    say "compute {round(elapsed)} ms"
